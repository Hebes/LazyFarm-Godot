; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Farm"
run/main_scene="uid://dsymr0mdri5pm"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://c7s7e61d44oq2"

[autoload]

ImGuiRoot="*res://addons/imgui-godot/data/ImGuiRoot.tscn"
GameManager="*res://Manager/Game/GameManager.tscn"
UtilsManager="*res://Manager/Utils/UtilsManager.tscn"
LoadingManager="*res://Manager/Loading/LoadingManager.tscn"
ResourceManager="*res://Manager/Resource/Resource_Manager.tscn"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Cursor="*res://addons/awesome_custom_cursor/Autoloads/Cursor.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor]

naming/scene_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/Inventory_Editor/plugin.cfg", "res://addons/awesome_custom_cursor/plugin.cfg", "res://addons/imgui-godot/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

